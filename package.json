{
  "name": "opencode-quota-monitor",
  "displayName": "OpenCode Quota Monitor",
  "description": "Monitor usage quotas across multiple OpenCode accounts",
  "version": "0.0.4",
  "publisher": "vinaosb",
  "author": "vinaosb",
  "packageManager": "npm@10.x",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vinaosb/opencode-antigravity-quota"
  },
  "license": "MIT",
  "keywords": [
    "opencode",
    "quota",
    "monitor",
    "usage",
    "api",
    "dashboard",
    "analytics",
    "rate-limit"
  ],
  "homepage": "https://github.com/vinaosb/opencode-antigravity-quota#readme",
  "bugs": {
    "url": "https://github.com/vinaosb/opencode-antigravity-quota/issues"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "opencodeQuota.refresh",
        "title": "OpenCode Quota: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "opencodeQuota.addAccount",
        "title": "OpenCode Quota: Add Account"
      },
      {
        "command": "opencodeQuota.removeAccount",
        "title": "OpenCode Quota: Remove Account"
      },
      {
        "command": "opencodeQuota.editAccount",
        "title": "OpenCode Quota: Edit Account"
      },
      {
        "command": "opencodeQuota.openDetails",
        "title": "OpenCode Quota: Open Details"
      },
      {
        "command": "opencodeQuota.importFromOpenCode",
        "title": "OpenCode Quota: Import OpenCode Accounts"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode-quota-monitor",
          "title": "Quota Monitor",
          "icon": "$(dashboard)"
        }
      ]
    },
    "views": {
      "opencode-quota-monitor": [
        {
          "id": "opencodeQuotaAccounts",
          "name": "Accounts"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode Quota Monitor",
      "properties": {
        "opencodeQuota.accounts": {
          "type": "array",
          "default": [],
          "description": "List of configured accounts"
        },
        "opencodeQuota.refreshIntervalSeconds": {
          "type": "number",
          "default": 300,
          "description": "Automatic refresh interval in seconds"
        },
        "opencodeQuota.pollIntervalMs": {
          "type": "number",
          "default": 300000,
          "minimum": 60000,
          "description": "Automatic refresh interval in milliseconds (minimum 60s)"
        },
        "opencodeQuota.cacheTTLSeconds": {
          "type": "number",
          "default": 600,
          "description": "Cache TTL in seconds"
        },
        "opencodeQuota.adapterConfig": {
          "type": "object",
          "default": {},
          "description": "Adapter configuration for mapping API responses"
        },
        "opencodeQuota.maxConcurrentRequests": {
          "type": "number",
          "default": 3,
          "description": "Maximum number of concurrent API requests"
        },
        "opencodeQuota.httpTimeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "HTTP request timeout in milliseconds"
        },
        "opencodeQuota.backoff.baseDelayMs": {
          "type": "number",
          "default": 10000,
          "description": "Base delay for exponential backoff in milliseconds"
        },
        "opencodeQuota.backoff.multiplier": {
          "type": "number",
          "default": 2,
          "description": "Multiplier for exponential backoff"
        },
        "opencodeQuota.backoff.maxDelayMs": {
          "type": "number",
          "default": 300000,
          "description": "Maximum delay for exponential backoff in milliseconds"
        },
        "opencodeQuota.backoff.maxRetries": {
          "type": "number",
          "default": 8,
          "description": "Maximum number of retries for rate limited requests"
        },
        "opencodeQuota.backoff.errorCacheSeconds": {
          "type": "number",
          "default": 30,
          "description": "Duration to cache error responses in seconds"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/nock": "^10.0.3",
    "@types/node": "18.x",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.39.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "nock": "^14.0.10",
    "sinon": "^21.0.1",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "p-limit": "^4.0.0",
    "pureimage": "^0.4.18",
    "vsce": "^2.15.0"
  },
  "icon": "icon.png"
}
