.env
.env.local
.env.*.local
*.key
*.pem
*.crt

# Development files
.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.mocha/
coverage/
.nyc_output/

# IDE
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# Sisyphus work directory (internal)
.sisyphus/

# OS files
.DS_Store
Thumbs.db
nul

# Documentation (not needed in package)
docs/
NOTES.md
TODO.md
CHANGELOG.md

# Test files
test/
**/*.test.ts
**/*.spec.ts
